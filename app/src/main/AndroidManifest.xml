<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_water_drop"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_water_drop"
        android:supportsRtl="true"
        android:theme="@style/Theme.ControleAgua">

        <!-- Tela Principal -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de Registro -->
        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:label="@string/title_registro" />

        <!-- Tela de Resumo -->
        <activity
            android:name=".ResumoActivity"
            android:exported="false"
            android:label="@string/title_resumo" />

    </application>

</manifest>
